; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="R.I.L.E.Y."
config/description="Really Impossible Landing Experiments, Yay!"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.082, 0.357, 0.71, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/icon="res://icon.png"

[audio]

driver/enable_input=false

[autoload]

Save="*res://scripts/autoload/save.gd"
Audio="*res://scripts/autoload/audio.gd"
Assets="*res://scripts/autoload/assets.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="triggers"
3d_physics/layer_4="ragdoll"
3d_physics/layer_5="debris"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.43, 0.71, 1, 1)

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false
